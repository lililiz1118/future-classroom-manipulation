  <!-- 双层支架 top_plate -->
  <xacro:include filename="$(find tuplateurdf)/urdf/tuplateurdf.urdf.xacro"/>
  <xacro:tuplateurdf> </xacro:tuplateurdf>
  <joint name="plate_mount_joint"
    type="fixed">
    <origin
      xyz="0 0 0.0"
      rpy="0 0 0" />
    <parent
      link="mount_link" />
    <child
      link="plate_base_link" />
    <axis
      xyz="0 0 0" />
  </joint>

  <!-- UR3 -->
  <xacro:arg name="ur3_enable"           default="$(optenv UR3_ENABLED 1)" />
  <xacro:if value="$(arg ur3_enable)">
    <xacro:include filename="$(find ur_description)/urdf/inc/ur3_macro.xacro" />
    <xacro:ur3_robot prefix="ur_arm_" />
    <joint  name="ur3_mount_joint"
      type="fixed">
      <origin
        xyz="0 0 0"
        rpy="0 0 -1.57" />
      <parent
        link="arm_0_mount_link" />
      <child
        link="ur_arm_base_link" />
      <axis
        xyz="0 0 0" />
    </joint> 

    <!-- 机械臂腕部相机 wrist_camera D405 -->
    <link  name="ur_wrist_plate_arm_link">
        <inertial>
          <origin
            xyz="0.00125 2.77555756156289E-17 0.0231023127437202"
            rpy="0 0 0" />
          <mass
            value="0.00877581178067328" />
          <inertia
            ixx="1.08059004611897E-05"
            ixy="6.35274710440725E-22"
            ixz="-1.79994501291539E-21"
