  <!-- 夹爪AG95 -->
  <xacro:arg name="gripper_enable"           default="$(optenv GRIPPER_ENABLED 1)" />
  <xacro:if value="$(arg gripper_enable)">
    <xacro:include filename="$(find dh_robotics_ag95_description)/urdf/dh_robotics_ag95_gripper.urdf.xacro" />
    <xacro:dh_robotics_ag95_gripper prefix="" parent="ur_wrist_plate_gripper_mount_link" >
        <origin xyz="0 0 0 " rpy="1.57 0 1.57  "/>
    </xacro:dh_robotics_ag95_gripper>
  </xacro:if>

  <!-- Gazebo ROS Control 插件，用于控制机械臂关节
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/</robotNamespace>
    </plugin>
  </gazebo> -->


  <!--
    Add an Intel RealSense family camera.  By default this is a D435, but can be changed with the
    TRACER_REALSENSE_MODEL environment variable. Valid model designations are:
    - d435 (default)
    - d435i
    - d415
    - d455
    Note: If two realsense's are included, both must be the same model type.
  -->
  <xacro:include filename="$(find tcurdf)/urdf/inc/realsense.urdf.xacro" />
  <!-- Primary Realsense Parameters -->
  <xacro:property name="rs_enabled" value="$(optenv TRACER_REALSENSE 1)"/>
  <xacro:property name="rs_model"   value="$(optenv TRACER_REALSENSE_MODEL d455)"/>
  <xacro:property name="rs_topic"   value="$(optenv TRACER_REALSENSE_TOPIC d455)" />
  <!-- <xacro:property name="rs_mount"   value="$(optenv TRACER_REALSENSE_MOUNT front)" /> -->
  <xacro:property name="rs_prefix"  value="$(optenv TRACER_REALSENSE_PREFIX d455)" />
  <xacro:property name="rs_parent"  value="$(optenv TRACER_REALSENSE_PARENT camera_0_screw_virtual_link)" />
  <xacro:property name="rs_xyz"     value="$(optenv TRACER_REALSENSE_OFFSET 0.0 0 0)" />
  <xacro:property name="rs_rpy"     value="$(optenv TRACER_REALSENSE_RPY 0 0 0)" />

  <!-- Includes Required for `realsense_sensor` -->
  <xacro:include filename="$(find realsense2_description)/urdf/_d455.urdf.xacro" />

  <xacro:if value="${rs_enabled}">
    <xacro:realsense_sensor rs_model="${rs_model}"
                            prefix="${rs_prefix}"
                            parent="${rs_parent}"
                            topic="${rs_topic}"
                            include="0">
      <origin xyz="${rs_xyz}" rpy="${rs_rpy}"/>
    </xacro:realsense_sensor>
  </xacro:if>

</robot>