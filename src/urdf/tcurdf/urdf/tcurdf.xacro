            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="package://tuplateurdf/meshes/ur_wrist_plate_arm_link.STL" />
          </geometry>
          <material
            name="">
            <color
              rgba="1 1 1 1" />
          </material>
        </visual>
        <collision>
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="package://tuplateurdf/meshes/ur_wrist_plate_arm_link.STL" />
          </geometry>
        </collision>
    </link>
    <joint  name="ur_wrist_plate_arm_joint"   type="fixed">
      <origin
        xyz="0.0 0.0 0.0 "
        rpy="1.57 -1.57 0.0 "  />
      <parent
        link="ur_arm_wrist_3_link" />
      <child
        link="ur_wrist_plate_arm_link" />
      <axis
        xyz="0 0 0" />
    </joint>
    <link  name="ur_wrist_plate_gripper_mount_link"> 
    </link>
    <!-- xyz="0.0025 0 0" -->
    <joint  name="ur_wrist_plate_gripper_mount_joint"  type="fixed">
      <origin
        
        xyz="0.0025 0 0"
        rpy="0 0 0" />
      <parent
        link="ur_wrist_plate_arm_link" />
      <child
        link="ur_wrist_plate_gripper_mount_link" />
