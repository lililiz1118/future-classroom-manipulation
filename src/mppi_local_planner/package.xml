<?xml version="1.0"?>
<package format="2">
  <name>mppi_local_planner</name>
  <version>0.1.0</version>
  <description>ROS1 move_base local planner plugin backed by the SA-MPPI controller.</description>

  <maintainer email="jt001@todo.todo">jt001</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>costmap_2d</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_core</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <export>
    <nav_core plugin="${prefix}/mppi_local_planner_plugin.xml"/>
  </export>
</package>
